{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "policy-ir.v1.json",
  "title": "Policy IR v1",
  "type": "object",
  "required": ["metadata", "policy"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["compiler_version", "input_digest", "output_digest", "generated_at"]
    },
    "policy": {
      "type": "object",
      "required": [
        "policy_id",
        "schema_version",
        "ruleset_version",
        "governance_version",
        "canon_spec_version",
        "states",
        "transitions"
      ]
    }
  }
}
